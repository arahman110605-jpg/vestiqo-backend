# Vestiqo Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it contains secrets.

# ============================================
# Database
# ============================================
# PostgreSQL connection string used by Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/vestiqo?schema=public

# ============================================
# Supabase Auth
# ============================================
# Get these from your Supabase Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# OpenAI (AI Mentor)
# ============================================
OPENAI_API_KEY=sk-your_openai_api_key_here

# ============================================
# Razorpay (Payments)
# ============================================
# Use test keys for development, live keys for production
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ============================================
# Firebase / FCM (Push Notifications)
# ============================================
# Path to your Firebase service account JSON or inline config
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# ============================================
# Redis (Caching)
# ============================================
# Optional: Upstash, Redis Cloud, or self-hosted
REDIS_URL=redis://localhost:6379

# ============================================
# App Config
# ============================================
# Node environment: development | staging | production
NODE_ENV=development
PORT=3000

# CORS — comma-separated allowed origins for Flutter apps
CORS_ORIGINS=http://localhost:3000,https://your-flutter-web-app.com
