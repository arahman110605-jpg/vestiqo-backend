// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------
// User & Profile Service
// -----------------------------------------
model User {
  id                String             @id @default(uuid())
  email             String             @unique
  supabaseAuthId    String             @unique // Maps to Supabase auth.users
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  profile           Profile?
  readinessScore    ReadinessScore?
  portfolioHealth   PortfolioHealthScore?
  simulatorAccount  SimulatorAccount?
  watchlists        Watchlist[]
  quizAttempts      QuizAttempt[]
  aiConversations   AiConversation[]
  notifications     Notification[]
  subscriptions     Subscription[]
  student           Student?
  dailyMissions     DailyMission[]
  discussionPosts   DiscussionPost[]
}

model Profile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  displayName       String?
  avatarUrl         String?
  experienceLevel   String?  // Beginner, Intermediate, Advanced
  riskProfile       String?  // Conservative, Moderate, Aggressive
  xp                Int      @default(0)
  level             Int      @default(1)
  learningStreak    Int      @default(0)
  coins             Int      @default(0)
  fcmToken          String?
}

model ReadinessScore {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  overallScore      Float    @default(0.0) // 0 - 100
  riskManagement    String?  // A, B, C, D
  diversification   String?
  stockAnalysis     String?
}

model PortfolioHealthScore {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  score             Float    @default(0.0)
  concentrationRisk Float    @default(0.0)
  volatility        Float    @default(0.0)
  updatedAt         DateTime @updatedAt
}

// -----------------------------------------
// Learning Service
// -----------------------------------------
model LearningPath {
  id          String   @id @default(uuid())
  name        String
  description String?
  order       Int      @default(0)
  lessons     Lesson[]
}

model Lesson {
  id              String          @id @default(uuid())
  learningPathId  String
  learningPath    LearningPath    @relation(fields: [learningPathId], references: [id])
  title           String
  content         String          // Legacy field — kept for backward compat
  type            String          // Flash, Deep, Simulation, CaseStudy
  durationMinutes Int             @default(2)
  order           Int             @default(0)
  steps           LessonStep[]
  versions        LessonVersion[]
  quizzes         Quiz[]
}

model LessonStep {
  id          String   @id @default(uuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type        String   // learn_card, interactive, scenario, quiz, ai_feedback
  title       String?
  content     Json     // Flexible JSON payload per step type
  order       Int      @default(0)
}

model LessonVersion {
  id          String   @id @default(uuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
  versionNum  Int
  content     String
  createdAt   DateTime @default(now())
}

model Quiz {
  id          String        @id @default(uuid())
  lessonId    String
  lesson      Lesson        @relation(fields: [lessonId], references: [id])
  questions   Json          // Scenario-based MCQs
  attempts    QuizAttempt[]
}

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  score       Float
  passed      Boolean
  attemptDate DateTime @default(now())
}

// -----------------------------------------
// Market & Simulator Service
// -----------------------------------------
model Stock {
  id          String       @id @default(uuid())
  ticker      String       @unique
  name        String
  sector      String?
  prices      StockPrice[]
  positions   SimulatorPosition[]
}

model StockPrice {
  id          String   @id @default(uuid())
  stockId     String
  stock       Stock    @relation(fields: [stockId], references: [id])
  price       Float
  timestamp   DateTime @default(now())
}

model Watchlist {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  stocks      Json     // Array of stock tickers or IDs
}

model SimulatorAccount {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  cashBalance Float    @default(1000000.0) // Virtual ₹10,00,000
  orders      SimulatorOrder[]
  positions   SimulatorPosition[]
}

model SimulatorOrder {
  id          String           @id @default(uuid())
  accountId   String
  account     SimulatorAccount @relation(fields: [accountId], references: [id])
  ticker      String
  type        String           // Buy, Sell
  quantity    Int
  price       Float
  status      String           // Pending, Executed, Failed
  createdAt   DateTime         @default(now())
}

model SimulatorPosition {
  id          String           @id @default(uuid())
  accountId   String
  account     SimulatorAccount @relation(fields: [accountId], references: [id])
  stockId     String
  stock       Stock            @relation(fields: [stockId], references: [id])
  quantity    Int
  averagePrice Float
}

// -----------------------------------------
// Certifications & Gamification
// -----------------------------------------
model Certification {
  id          String   @id @default(uuid())
  name        String   // Bronze, Silver, Gold, Platinum
  description String?
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  iconUrl     String?
}

model Challenge {
  id          String   @id @default(uuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
}

// -----------------------------------------
// AI & Notifications
// -----------------------------------------
model AiConversation {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  context     String   // Mentor, Coach, Compare
  messages    Json     // Array of chat messages
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// -----------------------------------------
// Subscriptions & B2B (Enterprise)
// -----------------------------------------
model Subscription {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  tier            String   // Free, Pro, Elite
  status          String   // Active, Canceled, Expired
  razorpayOrderId String?
  startDate       DateTime @default(now())
  endDate         DateTime?
  updatedAt       DateTime @updatedAt
}

model DailyMission {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String   // complete_lesson, execute_trade, review_portfolio
  target      Int      @default(1)
  progress    Int      @default(0)
  completed   Boolean  @default(false)
  date        DateTime @default(now())
  rewardXp    Int      @default(20)
  rewardCoins Int      @default(10)
}

model DiscussionThread {
  id        String   @id @default(uuid())
  ticker    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     DiscussionPost[]
}

model DiscussionPost {
  id        String           @id @default(uuid())
  threadId  String
  thread    DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  content   String
  upvotes   Int              @default(0)
  createdAt DateTime         @default(now())
}

model Organization {
  id          String      @id @default(uuid())
  name        String
  classrooms  Classroom[]
}

model Classroom {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  students       Student[]
}

model Student {
  id          String     @id @default(uuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id])
  classroomId String
  classroom   Classroom  @relation(fields: [classroomId], references: [id])
}
